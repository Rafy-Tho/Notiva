# --- Core ---
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173

# --- PostgreSQL (Prisma) ---
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require
# Optional: used by `prisma migrate dev` when the main database cannot create a shadow database
# SHADOW_DATABASE_URL=postgresql://username:password@host:5432/shadow

# --- JWT ---
JWT_ACCESS_SECRET=your-secure-random-secret-minimum-256-bits
JWT_TTL=7d

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Hostinger mail sender ---
HOSTINGER_MAIL_API_KEY=your-hostinger-mail-api-key
HOSTINGER_MAIL_MAILBOX_ID=your-hostinger-mailbox-id
HOSTINGER_API_BASE_URL=https://api.mail.hostinger.com
MAIL_FROM=your-email@example.com
MAIL_FROM_NAME=YourAppName

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback


# --- AI ---
ANTHROPIC_API_KEY=
AI_DAILY_QUOTA=20

